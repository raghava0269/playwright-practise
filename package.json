{
  "name": "playwright-practise",
  "version": "1.0.0",
  "description": "Playwright JavaScript framework: UI (POM) + API tests",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:all-browsers": "playwright test --project=ui-chromium --project=ui-firefox",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:no-flaky": "playwright test --grep-invert @flaky",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "test:serial": "playwright test --workers=1",
    "test:trace": "playwright test --project=ui-chromium --trace on",
    "ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.8"
  }
}
